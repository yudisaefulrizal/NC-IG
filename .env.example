# Server
PORT=8068
HOST=127.0.0.1

# Base URL publik yang bisa diakses Meta (isi dengan URL tunnel cloudflared
# saat development, atau https://nc-ig.nuscode.id saat sudah deploy).
# Dipakai untuk membangun redirect_uri OAuth dan image_url saat publishing.
PUBLIC_BASE_URL=

# Instagram App (dari Meta App Dashboard > Instagram > API setup)
INSTAGRAM_APP_ID=1678543236846823
# Wajib diisi sendiri, JANGAN commit nilai asli.
INSTAGRAM_APP_SECRET=
# Harus sama persis dengan salah satu OAuth Redirect URI terdaftar di dashboard.
# Contoh: ${PUBLIC_BASE_URL}/auth/instagram/callback
INSTAGRAM_REDIRECT_URI=

# Verify token bebas Anda tentukan sendiri (string acak), harus sama dengan
# yang diisi di kolom "Verify token" pada konfigurasi Webhook di dashboard Meta.
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=

# Lokasi file database SQLite
DATA_DIR=./data

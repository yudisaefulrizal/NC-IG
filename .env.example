# Server
PORT=8068
HOST=127.0.0.1

# Base URL publik yang bisa diakses Meta (isi dengan URL tunnel cloudflared
# saat development, atau https://nc-ig.nuscode.id saat sudah deploy).
# Dipakai untuk membangun redirect_uri OAuth dan image_url saat publishing.
PUBLIC_BASE_URL=

# Instagram App (dari Meta App Dashboard > Instagram > API setup)
INSTAGRAM_APP_ID=1678543236846823
# Wajib diisi sendiri, JANGAN commit nilai asli.
INSTAGRAM_APP_SECRET=
# Harus sama persis dengan salah satu OAuth Redirect URI terdaftar di dashboard.
# Contoh: ${PUBLIC_BASE_URL}/auth/instagram/callback
INSTAGRAM_REDIRECT_URI=

# Verify token bebas Anda tentukan sendiri (string acak), harus sama dengan
# yang diisi di kolom "Verify token" pada konfigurasi Webhook di dashboard Meta.
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=

# MySQL (dibuat manual sekali via: CREATE DATABASE + CREATE USER, lihat
# README/plan migrasi — jangan pakai user root di sini).
DB_HOST=localhost
DB_USER=nc_ig
DB_PASSWORD=
DB_NAME=nc_ig

# Dipakai HANYA sekali oleh `npm run migrate:from-sqlite` untuk membaca
# database SQLite lama saat pindah ke MySQL. Tidak dipakai app saat runtime
# biasa, boleh dihapus setelah migrasi data selesai & terverifikasi.
LEGACY_SQLITE_PATH=./data/nc-ig.sqlite

# Dipakai HANYA oleh `npm run migrate:from-sqlite` untuk membuat akun owner
# pertama (email owner@nc-ig.local) dengan password yang sama seperti
# password admin lama, supaya login tidak berubah setelah migrasi. Setelah
# migrasi, dashboard login pakai email+password dari tabel `accounts`, bukan
# variabel ini lagi — boleh dihapus dari .env setelah migrasi selesai.
ADMIN_PASSWORD=

# Secret untuk menandatangani session cookie. Bebas tentukan sendiri,
# string acak panjang. JANGAN commit nilai asli.
SESSION_SECRET=
